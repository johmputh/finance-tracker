{
  "name": "@finance-tracker/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "dotenv -e ../../.env -- nest start",
    "start:dev": "dotenv -e ../../.env -- nest start --watch",
    "dev": "pnpm start:dev",
    "start:prod": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@finance-tracker/database": "workspace:*",
    "@finance-tracker/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
