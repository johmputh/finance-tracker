{
  "name": "finance-tracker",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "frontend:dev": "pnpm --filter frontend dev",
    "backend:dev": "pnpm --filter backend start:dev",
    "db:generate": "pnpm --filter database db:generate",
    "db:migrate": "pnpm --filter database db:migrate",
    "db:seed": "pnpm --filter database db:seed",
    "db:reset": "pnpm --filter database db:reset",
    "db:studio": "pnpm --filter database db:studio",
    "bootstrap": "pnpm install && pnpm db:generate && pnpm build && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
